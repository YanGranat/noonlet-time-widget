<resources>
    <style name="AppDialogTheme" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorPrimary">?attr/appColorSurface</item>
        <item name="android:colorPrimaryDark">?attr/appColorBackground</item>
        <item name="android:colorAccent">?attr/appColorAccent</item>
        <item name="android:colorControlNormal">?attr/appColorMuted</item>
        <item name="android:colorControlActivated">?attr/appColorAccent</item>
        <item name="android:colorControlHighlight">?attr/appColorRipple</item>
        <item name="android:textColorPrimary">?attr/appColorText</item>
        <item name="android:textColorSecondary">?attr/appColorMuted</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimAmount">0.64</item>
        <item name="android:windowElevation">12dp</item>
        <item name="android:windowMinWidthMajor">0%</item>
        <item name="android:windowMinWidthMinor">0%</item>
        <item name="android:buttonBarButtonStyle">@style/AppDialogButton</item>
    </style>
    <style name="AppDialogThemeLight" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorPrimary">?attr/appColorSurface</item>
        <item name="android:colorPrimaryDark">?attr/appColorBackground</item>
        <item name="android:colorAccent">?attr/appColorAccent</item>
        <item name="android:colorControlNormal">?attr/appColorMuted</item>
        <item name="android:colorControlActivated">?attr/appColorAccent</item>
        <item name="android:colorControlHighlight">?attr/appColorRipple</item>
        <item name="android:textColorPrimary">?attr/appColorText</item>
        <item name="android:textColorSecondary">?attr/appColorMuted</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimAmount">0.32</item>
        <item name="android:windowElevation">12dp</item>
        <item name="android:windowMinWidthMajor">0%</item>
        <item name="android:windowMinWidthMinor">0%</item>
        <item name="android:buttonBarButtonStyle">@style/AppDialogButton</item>
    </style>
    <style name="AppDialogButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
    </style>
</resources>
