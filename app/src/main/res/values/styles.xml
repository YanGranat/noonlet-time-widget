<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="WidgetPinTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:windowBackground">#101114</item>
        <item name="android:colorBackground">?attr/appColorBackground</item>
        <item name="android:colorPrimary">?attr/appColorSurface</item>
        <item name="android:colorPrimaryDark">?attr/appColorBackground</item>
        <item name="android:colorAccent">?attr/appColorAccent</item>
        <item name="android:colorControlNormal">?attr/appColorMuted</item>
        <item name="android:colorControlActivated">?attr/appColorAccent</item>
        <item name="android:colorControlHighlight">?attr/appColorRipple</item>
        <item name="android:textColorPrimary">?attr/appColorText</item>
        <item name="android:textColorSecondary">?attr/appColorMuted</item>
        <item name="android:navigationBarColor">?attr/appColorBackground</item>
        <item name="android:statusBarColor">?attr/appColorBackground</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="appColorBackground">#09090B</item>
        <item name="appColorSurface">#19191C</item>
        <item name="appColorControlSurface">#171719</item>
        <item name="appColorSelectedSurface">#353538</item>
        <item name="appColorSectionHeader">#202023</item>
        <item name="appColorInput">#111113</item>
        <item name="appColorText">#F7F7F8</item>
