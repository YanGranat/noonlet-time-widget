        <item name="appColorSecondaryText">#C9C9D0</item>
        <item name="appColorAccent">#D9EF92</item>
        <item name="appColorOnAccent">#09090B</item>
        <item name="appColorBorder">#3B3B43</item>
        <item name="appColorSecondary">#2A2A2F</item>
        <item name="appColorSelectionSurface">#303725</item>
        <item name="appColorDivider">#2A2A2E</item>
        <item name="appColorSwatchBorder">#73737B</item>
        <item name="appColorSwitchChecked">#758E3D</item>
        <item name="appColorSwitchUnchecked">#4B4B54</item>
